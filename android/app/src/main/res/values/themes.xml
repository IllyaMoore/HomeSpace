<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints the real theme; this only styles the window before the
         first frame, so the launch does not flash white on a dark device. -->
    <style name="Theme.HomeSpace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
